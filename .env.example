# Copy to .env for local development. NEVER commit real secrets.
APP_ENV=demo                      # demo | production (production requires SECRET_KEY)
SECRET_KEY=                       # long random string; set in Render environment manager
DEMO_PUBLIC=true                  # anonymous read/simulate allowed (public demo only)
DEMO_USER_PASSWORD=               # password for demo_* accounts; empty -> 'demo-change-me' in APP_ENV=demo only
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
DATABASE_URL=                     # empty -> local SQLite ./data/twin.db ; Postgres: postgresql+psycopg://user:pass@host/db
MAX_JOB_WORKERS=1
JOB_WALL_CAP_S=900
RATE_LIMIT_PER_MIN=240
RESULT_RETENTION_RUNS=300
DEFAULT_MODE=DEMO_SYNTHETIC
LOG_LEVEL=INFO
MODEL_STORE_DIR=                  # empty -> ./model_store (shipped demo artifacts)
